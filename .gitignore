.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Editores e IDE
.vscode/
.idea/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.swp
*.swo

# .NET - compilacion, publicacion y pruebas
[Bb]in/
[Oo]bj/
artifacts/
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml

# Logs
*.log
logs/
npm-debug.log*

# Node.js
node_modules/
dist/
build/
coverage/
.next/
.nuxt/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Archivos temporales
tmp/
temp/
*.tmp
*.bak

# Docker
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# Bases de datos locales
*.sqlite
*.sqlite3
*.db

# Modelos locales de IA
models/
*.gguf
*.safetensors

# Graphify - resultados locales regenerables
graphify-out/
.graphifyignore

# Private operational evidence storage
.openirp-data/

