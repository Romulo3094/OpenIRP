# ==========================================
# OpenIRP - Git Ignore
# ==========================================

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Editores e IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/
npm-debug.log*

# Node.js
node_modules/
dist/
build/
coverage/
.next/
.nuxt/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Archivos temporales
tmp/
temp/
*.tmp
*.bak

# Docker
docker-compose.override.yml

# Bases de datos locales
*.sqlite
*.sqlite3
*.db

# Modelos locales de IA
models/
*.gguf
*.safetensors
